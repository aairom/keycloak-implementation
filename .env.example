# Copy to .env (scripts/init-env.sh does this and generates random secrets). Never commit .env.
# ---------------------------------------------------------------- Keycloak
# Keycloak version baked into the image (build argument).
KEYCLOAK_VERSION=26.8.2
# Public base URL of Keycloak as seen by browsers. This fixes the token issuer. https:// online.
KC_HOSTNAME=http://localhost:8080
# Host port for Keycloak, and the interface the published ports bind to (127.0.0.1 = local only).
KEYCLOAK_PORT=8080
BIND_ADDRESS=127.0.0.1
# First-start admin account of the master realm (change the password!).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-admin
# ---------------------------------------------------------------- Database
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=changeme-db
# ---------------------------------------------------------------- Demo realm (keycloak/realm/demo-realm.json)
DEMO_REALM=demo
# Passwords of the demo users alice (role app-user) and bob (role app-admin).
DEMO_USER_PASSWORD=changeme-alice
DEMO_ADMIN_PASSWORD=changeme-bob
# Allow self-registration on the login page (true/false).
DEMO_REGISTRATION_ALLOWED=true
# Public client "demo-cli" with the password grant, used by scripts/verify.sh. Set false in production.
DEMO_CLI_ENABLED=true
# Confidential client secrets.
WEBAPP_CLIENT_SECRET=changeme-webapp-secret
API_CLIENT_SECRET=changeme-api-secret
# Secret of client "demo-service" (client credentials grant, service-to-service).
SERVICE_CLIENT_SECRET=changeme-service-secret
# ---------------------------------------------------------------- Applications
# Public URL of the web app (registered as redirect URI in Keycloak) and host ports.
WEBAPP_PUBLIC_URL=http://localhost:8081
WEBAPP_PORT=8081
API_PORT=8082
# Public URL of the API (used by scripts/verify.sh).
API_PUBLIC_URL=http://localhost:8082
# Secret used to sign the web app session cookie.
WEBAPP_SESSION_SECRET=changeme-session-secret
# ---------------------------------------------------------------- Online deployment (docker-compose.prod.yml)
# DNS names pointing at the server, e.g. auth.example.com. Without a domain use sslip.io names.
KC_PUBLIC_HOST=auth.example.com
APP_PUBLIC_HOST=app.example.com
API_PUBLIC_HOST=api.example.com
# E-mail for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com
# Networks allowed to reach /admin and the master realm (space-separated CIDRs).
ADMIN_ALLOWED_CIDR="0.0.0.0/0 ::/0"
# ---------------------------------------------------------------- Scripts
# Images removed by scripts/cleanup-images.sh.
PROJECT_IMAGES="keycloak-demo/keycloak:26.8.2 keycloak-demo/api:1.0.0 keycloak-demo/webapp:1.0.0 quay.io/keycloak/keycloak:26.8.2 docker.io/library/postgres:17-alpine docker.io/library/caddy:2-alpine docker.io/library/python:3.12-slim"
